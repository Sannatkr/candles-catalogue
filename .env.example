# Copy this file to .env.local and paste your values in.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Razorpay — Dashboard → Settings → API Keys. The secret is server-only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The same key id again. Razorpay Checkout runs in the browser and needs it
# there; only the secret must stay on the server.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Dashboard → Settings → Webhooks. Used to prove a callback really came from them.
RAZORPAY_WEBHOOK_SECRET=

# Service-role key. Two jobs: the webhook marks a booking paid, and checkout
# promotes an order to paid once the Razorpay signature has been verified.
# A buyer must never be able to do that themselves, which is why it takes a key
# that bypasses row-level security. Supabase → Settings → API → service_role.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — for emails this site sends itself, such as order confirmations.
# NOT what sends the login codes: those come from Supabase's own servers, so
# the Resend SMTP details go in Supabase → Authentication → SMTP Settings.
# Free tier is 3,000/month, and it will only deliver to your own address until
# a sending domain is verified at resend.com → Domains.
RESEND_API_KEY=

# RapidShyp — auto-creates a courier shipment when an order is paid. Needs BOTH:
# the API key (RapidShyp Portal → Settings → Configure API) and the name of a
# pickup location you created in the portal. Leave either blank and shipment
# creation is skipped — checkout still works exactly the same.
RAPIDSHYP_API_KEY=
RAPIDSHYP_PICKUP_NAME=

# PostHog — optional. Without a key no analytics load at all: no script, no
# cookies, no network calls. posthog.com → Project Settings → Project API Key.
NEXT_PUBLIC_POSTHOG_KEY=
# eu.i.posthog.com or us.i.posthog.com, matching where the project was created.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
