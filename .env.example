# Copy this file to .env.local and paste your two Supabase values.
# Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Razorpay — Dashboard → Settings → API Keys. The secret is server-only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks. Used to prove a callback really came from them.
RAZORPAY_WEBHOOK_SECRET=
# Service-role key so the webhook can mark an order paid without a login.
# Supabase → Settings → API → service_role. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
